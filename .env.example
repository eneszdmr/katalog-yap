# Environment configuration for Katalog Yap.
# Firebase AI Logic uses App Check attestation and does not require a client-side GEMINI_API_KEY.
MARIADB_HOST=YOUR_MARIADB_HOST
MARIADB_PORT=3306
MARIADB_DATABASE=YOUR_MARIADB_DATABASE
MARIADB_USER=YOUR_MARIADB_USER
MARIADB_PASSWORD=YOUR_MARIADB_PASSWORD
MARIADB_SSL_ENABLED=false
MARIADB_POOL_MAX_SIZE=8
MARIADB_POOL_MIN_IDLE=2
MARIADB_CONNECT_TIMEOUT_MS=8000
MARIADB_SOCKET_TIMEOUT_MS=20000

