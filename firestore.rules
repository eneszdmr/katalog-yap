rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserAccount(data) {
      let keys = [
        'userId',
        'phone',
        'email',
        'displayName',
        'provider',
        'passwordHash',
        'passwordResetRequestedAt',
        'createdAt',
        'updatedAt'
      ];
      return data.keys().hasAll(keys)
        && data.keys().hasOnly(keys)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.phone is string && data.phone.size() <= 32
        && data.email is string && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 120
        && data.provider is string && data.provider in ['phone_password', 'google']
        && data.passwordHash is string && data.passwordHash.size() <= 256
        && data.passwordResetRequestedAt is int && data.passwordResetRequestedAt >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserAccount(incoming())
        && incoming().userId == request.auth.uid;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidUserAccount(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'phone',
          'email',
          'displayName',
          'provider',
          'passwordHash',
          'passwordResetRequestedAt',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
